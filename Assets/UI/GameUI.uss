/* Shared look for the in-game HUD, pause menu, end screen and main menu.
   Edit colors and sizes here (or open the .uxml files in UI Builder: Window > UI Toolkit > UI Builder). */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* ---------- Bars (health, special, boss) ---------- */

.bar {
    height: 22px;
    background-color: rgba(10, 10, 16, 0.85);
    border-width: 2px;
    border-color: rgb(230, 230, 240);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 6px;
}

.bar-fill,
.bar-trail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.bar-trail {
    background-color: rgb(255, 245, 220);
}

.bar-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

.health-fill {
    background-color: rgb(60, 205, 95);
}

.health-fill.low {
    background-color: rgb(235, 70, 60);
}

.special-bar {
    height: 14px;
}

.special-fill {
    background-color: rgb(70, 150, 255);
}

.special-bar.full {
    border-color: rgb(255, 225, 90);
}

.special-bar.full .special-fill {
    background-color: rgb(255, 205, 50);
}

/* ---------- HUD layout ---------- */

.player-panel {
    position: absolute;
    left: 24px;
    top: 20px;
    width: 340px;
}

.panel-title {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

.boss-panel {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 28px;
    align-items: stretch;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

/* Hidden until the battle starts: slides up and fades in */
.boss-panel.faded {
    opacity: 0;
    translate: 0 30px;
}

.boss-name {
    -unity-font-style: bold;
    font-size: 22px;
    color: rgb(255, 235, 235);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.boss-bar {
    height: 26px;
}

.boss-fill {
    background-color: rgb(200, 45, 60);
}

.boss-panel.phase2 .boss-fill {
    background-color: rgb(150, 40, 210);
}

.boss-panel.phase2 .boss-bar {
    border-color: rgb(220, 160, 255);
}

/* The boss's ultimate gauge, under its health bar; flashes when full */
.boss-meter-bar {
    height: 8px;
    margin-top: 4px;
    border-width: 1px;
}

.boss-meter-fill {
    background-color: rgb(255, 140, 40);
}

.boss-meter-bar.full .boss-meter-fill {
    background-color: rgb(255, 60, 40);
}

.special-bar.charging {
    border-color: rgb(140, 200, 255);
}

/* Thin line on the bar where phase 2 starts (GameUI positions it) */
.phase-marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    left: 50%;
    background-color: rgba(255, 255, 255, 0.8);
}

.boss-phase {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(220, 160, 255);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
    opacity: 0;
    padding: 0;
    margin: 4px 0 0 0;
}

.boss-panel.phase2 .boss-phase {
    opacity: 1;
}

/* ---------- Menus (pause, end screen, main menu) ---------- */

.overlay {
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.menu-box {
    min-width: 320px;
    padding: 28px 36px;
    background-color: rgba(20, 20, 30, 0.95);
    border-width: 2px;
    border-color: rgb(230, 230, 240);
    border-radius: 8px;
    align-items: stretch;
}

.menu-title {
    -unity-font-style: bold;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0 0 6px 0;
}

.menu-subtitle {
    font-size: 16px;
    color: rgb(190, 190, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 16px 0;
}

.victory .menu-title {
    color: rgb(255, 215, 80);
}

.defeat .menu-title {
    color: rgb(235, 70, 60);
}

.menu-button {
    height: 44px;
    margin: 6px 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 240, 250);
    background-color: rgb(45, 45, 65);
    border-width: 2px;
    border-color: rgb(90, 90, 120);
    border-radius: 6px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgb(70, 70, 105);
    border-color: rgb(255, 225, 90);
    scale: 1.03 1.03;
}

.menu-button:active {
    background-color: rgb(255, 205, 50);
    color: rgb(20, 20, 30);
}

/* ---------- Main menu ---------- */

.title-screen {
    background-color: rgb(12, 12, 20);
    align-items: center;
    justify-content: center;
}

.game-title {
    -unity-font-style: bold;
    font-size: 64px;
    color: rgb(255, 255, 255);
    text-shadow: 4px 4px 0 rgb(150, 40, 210);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.controls-list {
    font-size: 17px;
    color: rgb(220, 220, 235);
    white-space: normal;
    margin: 0 0 16px 0;
}
